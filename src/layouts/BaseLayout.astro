---
// BaseLayout: the shared "frame" every page sits inside.
// It holds the <head> (title, favicon, meta tags) and loads our global styles,
// so individual pages only need to provide their own content.

// Fonts are installed as npm packages and served from our own site (self-hosted)
// instead of loading them from Google's servers. That's faster, works offline,
// and avoids GDPR issues — loading Google Fonts directly has led to court rulings
// and waves of legal warning letters in Germany and Austria.
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/shippori-mincho/400.css';
import '@fontsource/shippori-mincho/500.css';
// Extra fonts for the design options 2 and 3 (only downloaded by the browser when a theme uses them)
import '@fontsource-variable/bodoni-moda/wght.css';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/jost/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/unbounded/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';

import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Hitomi — Sushi · Wok · Noodle in Wien',
	description = 'Hitomi: Sushi, Wok und Noodle aus der japanischen und chinesischen Küche — an zehn Standorten in Wien.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!--
			Temporary (design comparison): apply the chosen theme BEFORE the page is drawn,
			so there is no flash of the wrong colours. ?design=1|2|3 in the URL wins.
		-->
		<script is:inline>
			(() => {
				let id = new URLSearchParams(location.search).get('design');
				try {
					id = id ?? localStorage.getItem('hitomi-design');
				} catch {}
				if (id && id !== '0') document.documentElement.dataset.theme = id;
			})();
		</script>
	</head>
	<body>
		<!-- <slot /> is where each page's content gets inserted -->
		<slot />
	</body>
</html>
