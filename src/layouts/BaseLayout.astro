---
// BaseLayout: the shared "frame" every page sits inside.
// It holds the <head> (title, favicon, meta tags) and loads our global styles,
// so individual pages only need to provide their own content.

// Fonts are installed as npm packages and served from our own site (self-hosted)
// instead of loading them from Google's servers. That's faster, works offline,
// and avoids GDPR issues — loading Google Fonts directly has led to court rulings
// and waves of legal warning letters in Germany and Austria.
import '@fontsource-variable/unbounded/wght.css'; // wordmark
import '@fontsource-variable/fraunces/wght.css'; // headings
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/space-grotesk/wght.css'; // body text
import '../styles/fonts-jp.css'; // Japanese characters (trimmed to the kanji we use)

import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Hitomi — Sushi · Wok · Noodle in Wien',
	description = 'Hitomi: Sushi, Wok und Noodle aus der japanischen und chinesischen Küche — an zehn Standorten in Wien.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<!-- Favicon: the vermilion Hitomi sun (an SVG scales sharply at every size) -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Colours the browser bar on phones to match the paper background -->
		<meta name="theme-color" content="#efe7d9" />
		<!--
			Open Graph: how the page looks when the link is shared in WhatsApp,
			Facebook, LinkedIn etc. (title, description, language/region).
		-->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="de_AT" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<!-- <slot /> is where each page's content gets inserted -->
		<slot />
	</body>
</html>
