---
// The homepage. Each section is its own component, assembled here in order.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MenuSection from '../components/MenuSection.astro';
import ConceptsSection from '../components/ConceptsSection.astro';
import LocationsSection from '../components/LocationsSection.astro';
import AboutSection from '../components/AboutSection.astro';
---

<BaseLayout>
	<Header />
	<main>
		<Hero />
		<MenuSection />
		<ConceptsSection />
		<LocationsSection />
		<AboutSection />
	</main>
</BaseLayout>

<script>
	// Scroll reveal for all sections below the Hero (elements with data-reveal)
	import '../scripts/reveal';
</script>
