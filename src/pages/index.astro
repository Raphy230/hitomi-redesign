---
// The homepage. For now it's a placeholder that proves Tailwind works.
// We'll replace it section by section (Header, Hero, ...) in the next steps.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main class="flex min-h-screen flex-col items-center justify-center gap-6 text-center">
		<p class="eyebrow">Japanese cuisine · Vienna</p>
		<h1 class="text-7xl md:text-9xl">Hitomi</h1>
		<p class="font-jp text-2xl text-gold">瞳</p>
		<a href="/styleguide" class="mt-6 text-sm text-cream-muted underline decoration-gold/60 underline-offset-8 hover:text-cream">
			View the style guide
		</a>
	</main>
</BaseLayout>
