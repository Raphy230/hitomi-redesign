---
// The homepage. Each section is its own component, assembled here in order.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LocationsSection from '../components/LocationsSection.astro';
import GallerySection from '../components/GallerySection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
	<Header />
	<main id="main" tabindex="-1" class="outline-none">
		<Hero />
		<LocationsSection />
		<GallerySection />
	</main>
	<Footer />
</BaseLayout>

<script>
	// Scroll reveal for all sections below the Hero (elements with data-reveal)
	import '../scripts/reveal';
</script>
