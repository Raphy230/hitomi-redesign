---
// The homepage. For now it's a placeholder that proves Tailwind works.
// We'll replace it section by section (Header, Hero, ...) in the next steps.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main class="flex min-h-screen flex-col items-center justify-center gap-4 bg-stone-950 text-stone-100">
		<p class="text-xs uppercase tracking-[0.4em] text-amber-400/80">Setup complete</p>
		<h1 class="text-6xl font-light">Hitomi</h1>
		<p class="text-stone-400">Astro + Tailwind are running.</p>
	</main>
</BaseLayout>
