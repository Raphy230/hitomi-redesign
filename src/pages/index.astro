---
// The homepage. Each section is its own component, assembled here in order.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MenuSection from '../components/MenuSection.astro';
import ConceptsSection from '../components/ConceptsSection.astro';

// Temporary placeholders so the navigation links already have somewhere to jump to.
// Each one gets replaced by a real component in the next steps.
const upcoming = [
	{ id: 'standorte', label: 'Standorte' },
	{ id: 'ueber-uns', label: 'Über uns' },
];
---

<BaseLayout>
	<Header />
	<main>
		<Hero />
		<MenuSection />
		<ConceptsSection />

		{
			upcoming.map((section) => (
				<section id={section.id} class="flex min-h-[60vh] items-center border-t border-line/50">
					<div class="mx-auto w-full max-w-7xl px-6 md:px-12">
						<p class="eyebrow">Folgt in Kürze</p>
						<h2 class="mt-4 text-5xl text-ink/30">{section.label}</h2>
					</div>
				</section>
			))
		}
	</main>
</BaseLayout>

<script>
	// Scroll reveal for all sections below the Hero (elements with data-reveal)
	import '../scripts/reveal';
</script>
