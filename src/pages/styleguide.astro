---
// Style guide: a private reference page (localhost:4321/styleguide) that shows
// every colour and font in one place. Designers use pages like this to check
// that the whole "design system" looks right together before building sections.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';

// The colours are listed as data, and the HTML below loops over them with .map().
// This avoids copy-pasting the same swatch markup many times.
const colors = [
	{ name: 'paper', hex: '#efe7d9', className: 'bg-paper', role: 'Main background' },
	{ name: 'paper-shade', hex: '#e6dccb', className: 'bg-paper-shade', role: 'Cards, alternate sections' },
	{ name: 'paper-deep', hex: '#e4d9c6', className: 'bg-paper-deep', role: 'Edges, menu overlay' },
	{ name: 'line', hex: '#cdbfa8', className: 'bg-line', role: 'Borders, grid lines' },
	{ name: 'ink', hex: '#1c1814', className: 'bg-ink', role: 'Headings, main text' },
	{ name: 'ink-muted', hex: '#5e544a', className: 'bg-ink-muted', role: 'Secondary text' },
	{ name: 'red', hex: '#e2452a', className: 'bg-red', role: 'Hitomi sun, buttons, petals' },
	{ name: 'gold', hex: '#b9821c', className: 'bg-gold', role: 'Labels, thin lines' },
];
---

<BaseLayout title="Style Guide — Hitomi">
	<main class="poster-grid mx-auto max-w-6xl px-6 py-24 md:px-12">
		<p class="eyebrow">Design system · Washi Poster</p>
		<h1 class="mt-4 text-6xl md:text-8xl">Style Guide</h1>
		<div class="mt-10 h-px w-24 bg-red"></div>

		<!-- COLOURS -->
		<section class="mt-24">
			<p class="eyebrow">01 — Farbe</p>
			<div class="mt-8 grid grid-cols-2 gap-6 md:grid-cols-4">
				{
					colors.map((color) => (
						<div>
							<div class={`aspect-square border border-line ${color.className}`} />
							<p class="mt-3 text-sm text-ink">{color.name}</p>
							<p class="text-xs text-ink-muted">{color.hex} · {color.role}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- TYPOGRAPHY -->
		<section class="mt-24 space-y-16">
			<p class="eyebrow">02 — Typografie</p>

			<div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[200px_1fr]">
				<p class="text-sm text-ink-muted">Wordmark<br />Unbounded</p>
				<div class="text-5xl md:text-7xl"><Logo /></div>
			</div>

			<div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[200px_1fr]">
				<p class="text-sm text-ink-muted">Display<br />Fraunces</p>
				<div>
					<h2 class="text-6xl md:text-7xl">Frische Zutaten, kunstvoll zubereitet</h2>
					<p class="mt-4 font-display text-3xl text-ink-muted italic">Sushi · Wok · Noodle in Wien</p>
				</div>
			</div>

			<div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[200px_1fr]">
				<p class="text-sm text-ink-muted">Japanese accent<br />Shippori Mincho</p>
				<p class="font-jp text-7xl text-ink">千喜 <span class="text-red">寿司</span></p>
			</div>

			<div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[200px_1fr]">
				<p class="text-sm text-ink-muted">Body<br />Space Grotesk</p>
				<p class="max-w-xl text-lg text-ink-muted">
					Fließtext ist in Space Grotesk gesetzt: modern, technisch und gut lesbar. Zusammen mit der weichen Fraunces und
					dem breiten Unbounded-Wordmark entsteht der Look eines zeitgenössischen japanischen Plakats.
				</p>
			</div>
		</section>

		<!-- BUTTONS & DETAILS -->
		<section class="mt-24">
			<p class="eyebrow">03 — Buttons &amp; Details</p>
			<div class="mt-8 flex flex-wrap items-center gap-6">
				<a href="#" class="btn-primary">Tisch reservieren</a>
				<a href="#" class="btn-outline">Speisekarte entdecken</a>
				<a href="#" class="link-underline text-sm text-ink">Text link</a>
			</div>
		</section>
	</main>
</BaseLayout>
