---
// SakuraBranch: a fine, line-drawn cherry blossom branch.
// The original Hitomi homepage shows a large cherry blossom branch reaching in from
// the top right. We keep that motif, but draw it like ink on paper: a thin line,
// only a few blossoms, soft pink with a vermilion centre.
//
// Each blossom is drawn ONCE as a <symbol> (5 petals rotated by 72°), then
// re-used with <use>. That keeps the code short.

interface Props {
	class?: string;
	style?: string;
}
const { class: className = '', style } = Astro.props;

// Where the blossoms sit along the branch: x, y and size
const blossoms = [
	{ x: 452, y: 112, s: 42 },
	{ x: 330, y: 204, s: 50 },
	{ x: 262, y: 236, s: 34 },
	{ x: 498, y: 236, s: 38 },
	{ x: 168, y: 300, s: 44 },
];
// Closed buds: small dots
const buds = [
	{ x: 540, y: 64 },
	{ x: 300, y: 158 },
	{ x: 212, y: 334 },
];
---

<svg class={className} style={style} viewBox="0 0 600 400" fill="none" aria-hidden="true">
	<defs>
		<symbol id="sakura-blossom" viewBox="-12 -12 24 24">
			{[0, 72, 144, 216, 288].map((angle) => (
				<path d="M0 0 C-4.5 -3 -4.5 -9 -1.2 -11 L0 -9.6 L1.2 -11 C4.5 -9 4.5 -3 0 0Z" transform={`rotate(${angle})`} style="fill: var(--color-sakura)" />
			))}
			<circle r="1.7" style="fill: var(--color-red)" />
		</symbol>
	</defs>

	<!-- Branch and twigs, drawn as thin ink lines -->
	<g stroke-linecap="round" style="stroke: var(--color-ink)" stroke-opacity="0.45">
		<path stroke-width="1.8" d="M640 30 C560 48 482 84 420 140 C370 186 330 208 260 232 C212 248 180 270 150 306" />
		<path stroke-width="1.1" d="M420 140 C432 186 458 216 498 236" />
		<path stroke-width="1.1" d="M330 206 C322 176 310 164 300 158" />
		<path stroke-width="0.9" d="M196 266 C192 290 198 314 212 334" />
		<path stroke-width="0.9" d="M482 84 C500 78 520 70 540 64" />
	</g>

	{buds.map((b) => <circle cx={b.x} cy={b.y} r="4.5" style="fill: var(--color-sakura)" />)}

	{blossoms.map((b) => <use href="#sakura-blossom" x={b.x - b.s / 2} y={b.y - b.s / 2} width={b.s} height={b.s} />)}
</svg>
