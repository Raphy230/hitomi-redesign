---
// SakuraBranch: a cherry blossom branch in Japanese ink-painting (sumi-e) style.
// The original Hitomi homepage shows a large blossom branch reaching in from the
// top right. We keep that motif, painted like ink on washi paper:
//   - the branch is made of brush strokes that get thinner towards the tip
//   - blossoms have soft pink petals with a deeper centre and fine stamens
//   - closed buds and a few loose petals complete the picture
//
// Each blossom is drawn ONCE as a <symbol> (5 petals rotated by 72°), then
// re-used with <use>, each with its own size and rotation.

interface Props {
	class?: string;
	style?: string;
}
const { class: className = '', style } = Astro.props;

// Blossoms: position (x, y), size (s) and rotation (r)
const blossoms = [
	{ x: 742, y: 226, s: 60, r: 15 },
	{ x: 700, y: 96, s: 54, r: -10 },
	{ x: 612, y: 142, s: 70, r: 20 },
	{ x: 590, y: 292, s: 52, r: -25 },
	{ x: 548, y: 182, s: 46, r: 40 },
	{ x: 470, y: 214, s: 64, r: 0 },
	{ x: 396, y: 138, s: 56, r: -15 },
	{ x: 432, y: 168, s: 38, r: 30 },
	{ x: 360, y: 262, s: 58, r: 12 },
	{ x: 318, y: 302, s: 44, r: -30 },
	{ x: 330, y: 420, s: 54, r: 18 },
	{ x: 262, y: 350, s: 40, r: 5 },
	{ x: 236, y: 390, s: 50, r: -12 },
	{ x: 190, y: 432, s: 38, r: 25 },
];

// Closed buds: small ovals, slightly turned
const buds = [
	{ x: 782, y: 50, r: -30 },
	{ x: 668, y: 198, r: 40 },
	{ x: 452, y: 148, r: -20 },
	{ x: 294, y: 332, r: 30 },
	{ x: 606, y: 258, r: 10 },
	{ x: 212, y: 414, r: -40 },
	{ x: 372, y: 236, r: 60 },
];

// Loose petals that have already fallen from the branch
const loosePetals = [
	{ x: 150, y: 486, r: 30 },
	{ x: 520, y: 318, r: -50 },
	{ x: 660, y: 338, r: 110 },
	{ x: 268, y: 476, r: 200 },
];

const petalPath = 'M0 0 C-11 -7 -12 -22 -3 -27 L0 -23 L3 -27 C12 -22 11 -7 0 0Z';
---

<svg class={className} style={style} viewBox="0 0 800 520" fill="none" aria-hidden="true">
	<defs>
		<!-- Petal colour: deeper pink at the centre of the flower, almost white at the tips -->
		<radialGradient id="sakura-petal" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="27">
			<stop offset="0%" style="stop-color: var(--color-sakura-deep)" />
			<stop offset="45%" style="stop-color: var(--color-sakura)" />
			<stop offset="100%" style="stop-color: var(--color-sakura-light)" />
		</radialGradient>

		<symbol id="sakura-blossom" viewBox="-30 -30 60 60">
			{[0, 72, 144, 216, 288].map((angle) => <path d={petalPath} transform={`rotate(${angle})`} fill="url(#sakura-petal)" />)}
			<!-- stamens: fine lines with tiny dots, radiating from the centre -->
			<g style="stroke: var(--color-red-deep)" stroke-width="0.8" stroke-linecap="round">
				{[0, 45, 90, 135, 180, 225, 270, 315].map((angle) => (
					<line x1="0" y1="-3" x2="0" y2="-9" transform={`rotate(${angle})`} />
				))}
			</g>
			{[0, 45, 90, 135, 180, 225, 270, 315].map((angle) => (
				<circle cx="0" cy="-9.5" r="1.1" transform={`rotate(${angle})`} style="fill: var(--color-red)" />
			))}
			<circle r="2.6" style="fill: var(--color-red-deep)" />
		</symbol>
	</defs>

	<!--
		The branch: each segment is a separate brush stroke, a little thinner than the
		one before, so the branch tapers from the thick base (top right) to the fine tip.
	-->
	<g stroke-linecap="round" style="stroke: var(--color-ink)" stroke-opacity="0.82">
		<path stroke-width="10" d="M830 18 C760 40 700 70 640 120" />
		<path stroke-width="7" d="M640 120 C590 162 540 190 470 214" />
		<path stroke-width="5" d="M470 214 C410 234 360 262 318 300" />
		<path stroke-width="3.2" d="M318 300 C290 326 262 352 236 388" />
		<path stroke-width="2" d="M236 388 C220 404 206 418 190 432" />
		<!-- side twigs -->
		<path stroke-width="3.5" d="M640 120 C660 170 690 200 740 222" />
		<path stroke-width="3" d="M470 214 C452 172 430 150 396 138" />
		<path stroke-width="2.6" d="M318 300 C300 340 306 380 330 420" />
		<path stroke-width="3" d="M560 176 C590 220 600 250 590 290" />
		<path stroke-width="2.2" d="M700 74 C720 60 750 52 780 50" />
	</g>
	<!-- a lighter second stroke along the base: the "dry brush" texture of ink painting -->
	<path d="M826 24 C760 46 704 76 646 124" stroke-width="3" stroke-linecap="round" style="stroke: var(--color-paper)" stroke-opacity="0.35" />

	{buds.map((b) => <ellipse cx={b.x} cy={b.y} rx="5.5" ry="8" transform={`rotate(${b.r} ${b.x} ${b.y})`} style="fill: var(--color-sakura-deep)" />)}

	{
		blossoms.map((b) => (
			<use href="#sakura-blossom" x={b.x - b.s / 2} y={b.y - b.s / 2} width={b.s} height={b.s} transform={`rotate(${b.r} ${b.x} ${b.y})`} />
		))
	}

	{
		loosePetals.map((p) => (
			<path d={petalPath} transform={`translate(${p.x} ${p.y}) rotate(${p.r}) scale(0.55)`} fill="url(#sakura-petal)" opacity="0.8" />
		))
	}
</svg>
