---
// Hero: the first screen visitors see.
// Composition (back to front):
//   1. dark warm gradient background
//   2. the "Hitomi sun": the red circle from the logo, with a circular food photo
//      in front of it like an eclipse, and the brand's kanji 千喜 beside it
//   3. a few drifting cherry blossom petals
//   4. film grain over everything
//   5. the HITOMI wordmark as headline, a short line, and the two calls to action
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
// Importing an image (instead of linking to it) lets Astro optimize it at build time
import heroPhoto from '../assets/images/hero-sushi-chopsticks.jpg';

// A few falling petals. Each gets its own position, speed and delay so they
// never move in sync (which would look mechanical).
const petals = [
	{ left: '62%', size: 14, duration: '19s', delay: '-2s', opacity: 0.55 },
	{ left: '78%', size: 10, duration: '24s', delay: '-11s', opacity: 0.4 },
	{ left: '90%', size: 12, duration: '21s', delay: '-6s', opacity: 0.5 },
	{ left: '48%', size: 9, duration: '27s', delay: '-17s', opacity: 0.3 },
	{ left: '104%', size: 13, duration: '23s', delay: '-14s', opacity: 0.45 },
	{ left: '70%', size: 11, duration: '26s', delay: '-20s', opacity: 0.4 },
	{ left: '96%', size: 15, duration: '20s', delay: '-9s', opacity: 0.5 },
];
---

<section id="top" class="relative isolate flex min-h-svh flex-col overflow-hidden" aria-label="Willkommen bei Hitomi">
	<!-- 1. Background gradient (a hint of red warmth behind the sun) -->
	<div class="absolute inset-0 -z-30 bg-[radial-gradient(ellipse_at_72%_45%,#2b1715_0%,#171413_45%,#0e0d0c_100%)]"></div>

	<!--
		2. The Hitomi sun as an "eclipse":
		   - behind: the solid red circle from the logo, shifted up and to the right
		   - in front: a circular window showing the food photo
		   The red peeks out as a crescent, so the brand circle and the food are one image.
	-->
	<div
		class="absolute top-[11vh] right-[-6vw] -z-20 size-[56vw] sm:top-[13vh] sm:size-[46vw] lg:top-1/2 lg:right-[8vw] lg:size-[min(38vw,580px)] lg:-translate-y-1/2"
		aria-hidden="true"
	>
		<!-- soft red glow around everything -->
		<div class="sun-in absolute -inset-[35%] rounded-full bg-[radial-gradient(circle,rgba(184,49,47,0.26)_0%,transparent_62%)]" style="--delay: 300ms"></div>

		<!-- the red sun, offset behind the photo -->
		<div class="sun-in absolute inset-0 translate-x-[9%] -translate-y-[7%] rounded-full bg-[radial-gradient(circle_at_32%_28%,#d24a46_0%,#b8312f_40%,#7a1a1a_100%)]" style="--delay: 150ms"></div>

		<!-- the photo window -->
		<div class="sun-in absolute inset-0 overflow-hidden rounded-full shadow-[0_30px_80px_rgba(0,0,0,0.6)] ring-1 ring-cream/10" style="--delay: 450ms">
			<!--
				Astro's <Image> automatically resizes and compresses the 2400px original
				into several smaller WebP files. "widths" + "sizes" let the browser pick
				the smallest file that still looks sharp on the visitor's screen.
			-->
			<Image
				src={heroPhoto}
				alt=""
				widths={[400, 700, 1000, 1400]}
				sizes="(min-width: 1024px) 580px, 56vw"
				loading="eager"
				fetchpriority="high"
				class="turn size-full scale-[1.15] object-cover object-[50%_40%]"
			/>
			<!-- darken the edges so the photo melts into the circle -->
			<div class="absolute inset-0 bg-[radial-gradient(circle,transparent_45%,rgba(14,13,12,0.55)_100%)]"></div>
		</div>

		<!-- the brand kanji, set vertically like the stamp in Hitomi's logo -->
		<p class="rise absolute top-1/2 -left-[12%] -translate-y-1/2 font-jp text-[clamp(1.6rem,3.2vw,3rem)] leading-none tracking-[0.3em] text-red [writing-mode:vertical-rl] max-lg:hidden" style="--delay: 1100ms">
			千喜
		</p>
	</div>

	<!-- 3. Drifting cherry blossom petals (hidden for people who prefer reduced motion) -->
	<div class="pointer-events-none absolute inset-0 -z-10 motion-reduce:hidden" aria-hidden="true">
		{
			petals.map((p) => (
				<svg
					class="petal absolute top-0"
					viewBox="-6 -12 12 13"
					width={p.size}
					height={p.size}
					style={`left: ${p.left}; --duration: ${p.duration}; --delay: ${p.delay}; --petal-opacity: ${p.opacity}`}
				>
					<path d="M0 0 C-4.5 -3 -4.5 -9 -1.2 -11 L0 -9.6 L1.2 -11 C4.5 -9 4.5 -3 0 0Z" fill="#ecc3c3" />
				</svg>
			))
		}
	</div>

	<!-- 4. Film grain + a fade into the next section -->
	<div class="grain pointer-events-none absolute inset-0 -z-10 opacity-[0.08] mix-blend-overlay"></div>
	<div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-charcoal-900 to-transparent"></div>
	<!-- On phones the text overlaps the sun, so darken the lower half for readability -->
	<div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-t from-charcoal-950/90 via-charcoal-950/40 to-transparent lg:hidden"></div>

	<!-- 5. Content -->
	<div class="mx-auto flex w-full max-w-7xl flex-1 items-end px-6 pt-32 pb-16 md:px-12 lg:items-center lg:pb-24">
		<div class="max-w-xl">
			<p class="eyebrow rise flex items-center gap-3" style="--delay: 400ms">
				<span class="inline-block size-1.5 rounded-full bg-red"></span>
				Japanisch · Chinesisch
			</p>

			<!--
				The brand IS the headline. The <h1> contains the Logo component, whose
				accessible name is "Hitomi" — so screen readers and Google read "Hitomi".
			-->
			<h1 class="rise mt-7 text-[clamp(2.75rem,6.4vw,5.25rem)] md:mt-9" style="--delay: 550ms">
				<Logo />
			</h1>

			<p class="rise mt-6 font-display text-2xl font-light text-cream md:mt-7 md:text-[2rem]" style="--delay: 700ms">
				Sushi · Wok · Noodle <em class="text-gold-light">in Wien</em>
			</p>

			<p class="rise mt-5 max-w-sm text-sm leading-relaxed text-cream-muted md:text-[0.95rem]" style="--delay: 850ms">
				Frische Zutaten, kunstvoll zubereitet — von Sushi und Maki bis zu Nudeln und Wok-Gerichten. An zehn Standorten in
				der Stadt.
			</p>

			<div class="rise mt-10 flex flex-wrap gap-3 md:mt-12 md:gap-4" style="--delay: 1000ms">
				<a href="#standorte" class="btn-primary">Tisch reservieren</a>
				<a href="#speisekarte" class="btn-outline">Speisekarte entdecken</a>
			</div>
		</div>
	</div>

	<!-- Bottom bar: small facts left/right, scroll cue in the middle -->
	<!-- (only on large screens — on phones and tablets the buttons need the space) -->
	<div class="rise absolute inset-x-0 bottom-0 hidden lg:block" style="--delay: 1300ms">
		<div class="mx-auto flex max-w-7xl items-end justify-between px-6 pb-8 text-[0.65rem] tracking-[0.3em] text-cream-muted uppercase md:px-12">
			<span class="hidden sm:block">10 Standorte · Wien</span>
			<a href="#speisekarte" class="mx-auto flex flex-col items-center gap-3 transition-colors hover:text-cream sm:mx-0">
				Entdecken
				<span class="relative block h-12 w-px overflow-hidden bg-cream/15">
					<span class="absolute inset-0 bg-gold motion-safe:animate-[scroll-line_2.4s_var(--ease-luxe)_infinite]"></span>
				</span>
			</a>
			<span class="hidden sm:block">Auch zum Mitnehmen</span>
		</div>
	</div>
</section>
