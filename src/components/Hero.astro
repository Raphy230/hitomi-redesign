---
// Hero — Direction A: "Durch die Sonne" (through the sun)
//
// First screen: a symmetrical "film poster". The red Hitomi sun sits in the centre,
// the HITOMI wordmark runs across it, 千喜 stands at the left edge.
//
// On scroll the section is pinned and the sun becomes a window: it grows until a
// full-screen sushi photo fills the screen, while the letters drift apart.
// The photo then fades into the paper colour, and the next section follows
// without a visible edge — like one continuous camera move.
//
// HOW THE SUN AND THE PHOTO STAY IN SYNC:
// both use one CSS variable, --r (the sun's radius). The red disc is 2 × --r wide,
// and the photo is cut to a circle of radius --r (clip-path). GSAP animates only --r.
import { Image } from 'astro:assets';
import revealPhoto from '../assets/images/sushi-rolls-ginger.jpg';

const letters = ['H', 'I', 'T', '●', 'M', 'I'];

// Drifting petals: each with its own position, speed and delay
const petals = [
	{ left: '62%', size: 14, duration: '19s', delay: '-2s', opacity: 0.5 },
	{ left: '78%', size: 10, duration: '24s', delay: '-11s', opacity: 0.4 },
	{ left: '90%', size: 12, duration: '21s', delay: '-6s', opacity: 0.45 },
	{ left: '30%', size: 9, duration: '27s', delay: '-17s', opacity: 0.3 },
	{ left: '104%', size: 13, duration: '23s', delay: '-14s', opacity: 0.4 },
	{ left: '48%', size: 11, duration: '26s', delay: '-20s', opacity: 0.35 },
];
---

<section id="top" class="hero relative isolate h-svh overflow-hidden" aria-label="Willkommen bei Hitomi">
	<!-- Background: warm paper, with a soft glow behind the sun and slightly deeper edges -->
	<div class="absolute inset-0 -z-30 bg-[radial-gradient(ellipse_at_50%_50%,var(--color-glow)_0%,var(--color-paper)_45%,var(--color-paper-deep)_100%)]"></div>

	<!-- A fine poster grid and two rings around the sun -->
	<div class="pointer-events-none absolute inset-0 -z-20" aria-hidden="true">
		<div class="poster-grid absolute inset-0"></div>
		<div class="absolute top-1/2 left-1/2 size-[calc(var(--r0)*2.7)] -translate-1/2 rounded-full border border-ink/20"></div>
		<div class="absolute top-1/2 left-1/2 size-[calc(var(--r0)*3.6)] -translate-1/2 rounded-full border border-dashed border-ink/15"></div>
	</div>

	<!-- The photo, cut to a circle the size of the sun. Revealed on scroll. -->
	<div class="hero-photo absolute inset-0 -z-20" style="clip-path: circle(var(--r) at 50% 50%)" aria-hidden="true">
		<Image
			src={revealPhoto}
			alt=""
			widths={[800, 1400, 2000, 2400]}
			sizes="100vw"
			loading="eager"
			class="hero-photo-img size-full object-cover object-[40%_55%]"
		/>
		<!-- paper-coloured veil: invisible at first, covers the photo at the end of the scroll -->
		<div class="hero-photo-shade absolute inset-0 bg-paper opacity-0"></div>
	</div>

	<!-- The red sun (fades away on scroll to reveal the photo inside it) -->
	<div class="hero-sun pointer-events-none absolute top-1/2 left-1/2 -z-10 -translate-1/2" aria-hidden="true">
		<div class="sun-rise">
			<div class="absolute top-1/2 left-1/2 size-[calc(var(--r)*3.4)] -translate-1/2 rounded-full bg-[radial-gradient(circle,color-mix(in_srgb,var(--color-red)_28%,transparent)_0%,transparent_62%)]"></div>
			<div class="relative size-[calc(var(--r)*2)] rounded-full bg-[radial-gradient(circle_at_32%_28%,var(--color-sun-hi)_0%,var(--color-red)_40%,var(--color-sun-lo)_100%)] shadow-[inset_-20px_-30px_80px_rgba(0,0,0,0.3)]"></div>
		</div>
	</div>

	<!-- Drifting cherry blossom petals (hidden for reduced motion) -->
	<div class="pointer-events-none absolute inset-0 -z-10 motion-reduce:hidden" aria-hidden="true">
		{
			petals.map((p) => (
				<svg
					class="petal absolute top-0"
					viewBox="-6 -12 12 13"
					width={p.size}
					height={p.size}
					style={`left: ${p.left}; --duration: ${p.duration}; --delay: ${p.delay}; --petal-opacity: ${p.opacity}`}
				>
					<path d="M0 0 C-4.5 -3 -4.5 -9 -1.2 -11 L0 -9.6 L1.2 -11 C4.5 -9 4.5 -3 0 0Z" style="fill: var(--color-petal)" />
				</svg>
			))
		}
	</div>

	<!-- Film grain -->
	<div class="grain pointer-events-none absolute inset-0 z-0 opacity-[0.08] mix-blend-overlay"></div>

	<!--
		Two layers per animated element: GSAP moves the OUTER element on scroll,
		while the CSS "rise" entrance animation runs on the INNER one.
		(If both touched the same element, they would fight over its transform.)
	-->

	<!-- Eyebrow above the sun -->
	<div class="hero-fade absolute inset-x-0 top-[calc(50%-var(--r0)-4.5rem)] z-10 text-center">
		<p class="eyebrow rise" style="--delay: 700ms">Japanisch · Chinesisch</p>
	</div>

	<!-- The wordmark across the sun. The O is an ink circle on the vermilion sun. -->
	<h1 class="absolute top-1/2 left-1/2 z-10 -translate-1/2">
		<span class="sr-only">Hitomi</span>
		<span
			class="wordmark flex items-center text-[clamp(3rem,11vw,10rem)] leading-none text-ink"
			aria-hidden="true"
		>
			{
				letters.map((letter, i) => (
					<span class="wm-letter inline-block">
						<span class="rise inline-block" style={`--delay: ${450 + i * 70}ms`}>
							{letter === '●' ? (
								<span class="mx-[0.12em] inline-block size-[0.78em] translate-y-[0.04em] rounded-full bg-ink" />
							) : (
								letter
							)}
						</span>
					</span>
				))
			}
		</span>
	</h1>

	<!-- Tagline below the sun -->
	<div class="hero-fade absolute inset-x-0 top-[calc(50%+var(--r0)+1.75rem)] z-10 px-6 text-center">
		<p class="rise font-display text-2xl font-light text-ink md:text-3xl" style="--delay: 950ms">
			Sushi · Wok · Noodle <em class="text-gold-light">in Wien</em>
		</p>
	</div>

	<!-- Stamps at the edges (large screens only) -->
	<div class="hero-stamp-left absolute top-1/2 left-12 z-10 hidden -translate-y-1/2 md:block" aria-hidden="true">
		<p class="rise font-jp text-3xl leading-none tracking-[0.4em] text-red [writing-mode:vertical-rl]" style="--delay: 1200ms">千喜</p>
	</div>
	<div class="hero-stamp-right absolute top-1/2 right-12 z-10 hidden -translate-y-1/2 md:block" aria-hidden="true">
		<p class="rise text-[0.65rem] tracking-label text-ink-muted uppercase [writing-mode:vertical-rl]" style="--delay: 1200ms">
			Zehn Standorte · Wien
		</p>
	</div>

	<!-- Calls to action, bottom centre -->
	<div class="hero-fade absolute inset-x-0 bottom-[7vh] z-10 px-6">
		<div class="rise flex flex-wrap justify-center gap-3 md:gap-4" style="--delay: 1100ms">
			<a href="#standorte" class="btn-primary">Tisch reservieren</a>
			<a href="#speisekarte" class="btn-outline">Speisekarte entdecken</a>
		</div>
	</div>
</section>

<style>
	/*
		--r0: the sun's starting radius (smaller of 34% of the width and 26% of the height).
		--r:  the current radius. Starts at --r0; GSAP grows it on scroll.
	*/
	.hero {
		--r0: min(34vw, 26vh);
		--r: var(--r0);
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const hero = document.querySelector<HTMLElement>('.hero')!;
	const q = gsap.utils.selector(hero);

	// Starting radius in px (read from the CSS, so CSS stays the single source of truth)
	const startRadius = () => {
		const probe = document.createElement('div');
		probe.style.width = 'var(--r0)';
		hero.appendChild(probe);
		const r = probe.getBoundingClientRect().width;
		probe.remove();
		return r;
	};
	// End radius: big enough that the circle covers the corners of the screen
	const endRadius = () => Math.hypot(window.innerWidth / 2, window.innerHeight / 2) + 40;

	const mm = gsap.matchMedia();

	mm.add('(prefers-reduced-motion: no-preference)', () => {
		const tl = gsap.timeline({
			defaults: { ease: 'none' },
			scrollTrigger: {
				trigger: hero,
				start: 'top top',
				end: '+=200%', // pinned for 2 screen heights of scrolling
				pin: true,
				scrub: 0.8,
				invalidateOnRefresh: true, // re-measure on resize
			},
		});

		// 1. The circle grows from the sun's size to full screen (photo and sun together)
		tl.fromTo(hero, { '--r': () => `${startRadius()}px` }, { '--r': () => `${endRadius()}px`, ease: 'power2.in', duration: 0.7 }, 0);

		// 2. The red fades away early, so the photo appears *inside* the sun first
		tl.to(q('.hero-sun'), { opacity: 0, duration: 0.35 }, 0.05);

		// 3. The photo settles from a slight zoom
		tl.fromTo(q('.hero-photo-img'), { scale: 1.25 }, { scale: 1, duration: 1 }, 0);

		// 4. Letters drift apart from the centre and fade
		tl.to(
			q('.wm-letter'),
			{
				x: (i: number) => (i - 2.5) * Math.min(window.innerWidth * 0.09, 140),
				opacity: 0,
				filter: 'blur(6px)',
				duration: 0.5,
			},
			0.05,
		);

		// 5. Stamps slide outwards, small texts and buttons fade
		tl.to(q('.hero-stamp-left'), { x: -80, opacity: 0, duration: 0.35 }, 0);
		tl.to(q('.hero-stamp-right'), { x: 80, opacity: 0, duration: 0.35 }, 0);
		tl.to(q('.hero-fade'), { opacity: 0, y: -20, duration: 0.25, stagger: 0.03 }, 0);

		// 6. At the end the photo fades into paper, so the Hero hands over seamlessly
		//    to the next section (no visible edge between the two sections)
		//    (between 0.7 and 0.8 the full photo simply holds — a moment to look at the food)
		tl.to(q('.hero-photo-shade'), { opacity: 1, duration: 0.2, ease: 'power1.in' }, 0.8);
	});
	// With reduced motion nothing is pinned or animated: the sun and wordmark simply stay.
</script>
