---
// AboutSection ("Über uns"): the brand story, told through the two characters
// in every Hitomi logo: 千喜 — literally "thousand" (千) and "joy" (喜).
// All promises in the text come from Hitomi's own words on hitomi.at
// (fresh, high-quality ingredients; artful techniques; friendly service; takeaway).
const pillars = [
	{
		title: 'Frische Zutaten',
		text: 'Hervorragende Speisen beginnen bei den hochwertigsten Zutaten: frischer Fisch für Sushi und Sashimi, knackiges Gemüse für den Wok.',
	},
	{
		title: 'Kunstvolles Handwerk',
		text: 'Japanische und chinesische Küche, mit kunstvollen Techniken zubereitet. In unseren Wok-&-Grill-Restaurants live vor Ihren Augen.',
	},
	{
		title: 'Herzlich willkommen',
		text: 'Freundlicher Service und eine einladende Atmosphäre, damit Sie sich bei uns wohlfühlen. Oder Sie genießen zu Hause: Alle Speisen gibt es auch zum Mitnehmen.',
	},
];
---

<section id="ueber-uns" class="relative overflow-hidden border-t border-line bg-paper py-24 md:py-36" aria-labelledby="about-title">
	<div class="mx-auto grid max-w-7xl items-center gap-16 px-6 md:grid-cols-12 md:px-12">
		<!-- Left: the two characters, large, inside the Hitomi sun -->
		<figure class="relative mx-auto w-full max-w-[420px] md:col-span-5" data-reveal>
			<div class="relative aspect-square">
				<!-- thin ring, like on the hero poster -->
				<div class="absolute -inset-[9%] rounded-full border border-ink/15" aria-hidden="true"></div>
				<div class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_32%_28%,var(--color-sun-hi)_0%,var(--color-red)_40%,var(--color-sun-lo)_100%)]" aria-hidden="true"></div>
				<p class="absolute inset-0 flex items-center justify-center gap-[0.2em] font-jp text-[clamp(4rem,12vw,8.5rem)] leading-none text-paper [writing-mode:vertical-rl]" lang="ja">
					千喜
				</p>
			</div>
			<figcaption class="mt-14 flex items-center justify-center gap-6 text-center text-sm text-ink-muted">
				<span><span class="font-jp text-lg text-ink" lang="ja">千</span> tausend</span>
				<span class="h-px w-8 bg-line" aria-hidden="true"></span>
				<span><span class="font-jp text-lg text-ink" lang="ja">喜</span> Freude</span>
			</figcaption>
		</figure>

		<!-- Right: story and pillars -->
		<div class="md:col-span-6 md:col-start-7">
			<p class="eyebrow flex items-center gap-3" data-reveal>
				<span class="inline-block size-1.5 rounded-full bg-red"></span>
				Über uns
			</p>
			<h2 id="about-title" class="mt-5 text-[clamp(2.5rem,5.5vw,4.5rem)]" data-reveal>
				Tausend Freuden, <em class="text-red">ein Versprechen.</em>
			</h2>
			<p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-muted" data-reveal>
				In jedem Hitomi-Logo stehen zwei Zeichen: 千喜, „tausend Freuden“. Dahinter steht ein einfaches Versprechen, das an allen zehn
				Standorten in Wien gilt.
			</p>

			<ol class="mt-12 space-y-8">
				{
					pillars.map((pillar, i) => (
						<li class="grid grid-cols-[3rem_1fr] gap-4 border-t border-line pt-6" data-reveal>
							<span class="font-sans text-xs tracking-[0.2em] text-gold">0{i + 1}</span>
							<div>
								<h3 class="text-2xl font-normal">{pillar.title}</h3>
								<p class="mt-2 text-ink-muted">{pillar.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>
