---
// ConceptsSection ("Konzepte"): Hitomi's five restaurant concepts, set like the
// rows of a poster or a table of contents: number · name · description · locations.
// Hovering a row (desktop) turns its number red and slides the name slightly —
// a quiet hint that the rows belong together with the locations below.
import { concepts } from '../data/concepts';

const locationCount = concepts.reduce((sum, c) => sum + c.locations.length, 0);
---

<section id="konzepte" class="relative border-t border-line bg-paper-shade py-24 md:py-36" aria-labelledby="concepts-title">
	<div class="mx-auto max-w-7xl px-6 md:px-12">
		<!-- Intro -->
		<div class="grid gap-8 md:grid-cols-12">
			<div class="md:col-span-7">
				<p class="eyebrow flex items-center gap-3" data-reveal>
					<span class="inline-block size-1.5 rounded-full bg-red"></span>
					Konzepte
				</p>
				<h2 id="concepts-title" class="mt-5 text-[clamp(2.5rem,6vw,5rem)]" data-reveal>
					Fünf Konzepte. <em class="text-red">Ein Hitomi.</em>
				</h2>
			</div>
			<p class="max-w-md self-end text-ink-muted md:col-span-4 md:col-start-9" data-reveal>
				Vom ruhigen Abendessen à la carte bis zum Teppanyaki-Grill: Jedes Hitomi hat seinen eigenen Charakter. Insgesamt {locationCount} Mal in
				Wien.
			</p>
		</div>

		<!-- The concepts -->
		<ol class="mt-14 border-b border-line md:mt-20">
			{
				concepts.map((concept, i) => (
					<li class="group grid gap-x-8 gap-y-4 border-t border-line py-9 md:grid-cols-12 md:py-12" data-reveal>
						<span class="font-sans text-xs tracking-[0.2em] text-gold transition-colors duration-500 md:col-span-1 md:pt-3 md:group-hover:text-red">
							0{i + 1}
						</span>

						<div class="md:col-span-4">
							<h3 class="text-3xl leading-tight transition-transform duration-700 ease-luxe md:text-[2.6rem] md:group-hover:translate-x-2">
								{concept.name}
								<span class="ml-2 inline-block size-2.5 scale-0 rounded-full bg-red align-middle transition-transform duration-500 ease-luxe group-hover:scale-100" aria-hidden="true" />
							</h3>
							<p class="mt-2 font-display text-lg text-ink-muted italic">{concept.tagline}</p>
						</div>

						<p class="text-ink-muted md:col-span-4">{concept.description}</p>

						<ul class="flex flex-wrap content-start gap-2 md:col-span-3 md:justify-end" aria-label={`Standorte ${concept.name}`}>
							{concept.locations.map((location) => (
								<li
									class="flex items-baseline gap-2 rounded-full border border-ink/20 bg-paper px-3 py-1.5 text-xs transition-colors duration-300 hover:border-red"
									title={location.address}
								>
									<span class="font-wordmark text-[0.7rem] font-semibold">{location.district}</span>
									<span class="text-ink-muted">{location.name}</span>
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>

		<div class="mt-12 flex justify-center md:justify-end" data-reveal>
			<a href="#standorte" class="btn-primary">Standort finden</a>
		</div>
	</div>
</section>
